# MSP4GROWTH Environment Variables
# Copy this file to .env and fill in your values

# Gurobi License Configuration
GUROBI_WLS_ACCESS_ID=your-access-id-here
GUROBI_WLS_SECRET=your-secret-here
GUROBI_LICENSE_ID=your-license-id-here
GUROBI_LOG_FILE=logs/gurobi.log

# Thread Configuration
GUROBI_THREADS=12
OMP_NUM_THREADS=12
MKL_NUM_THREADS=12
OPENBLAS_NUM_THREADS=12

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_LOG_LEVEL=info

# Optional: Prometheus monitoring
ENABLE_METRICS=true